## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# This will work for any sub-folder also - IMPORTANT for your case
**/bin/
**/obj/
**/out/
**/Debug/
**/Release/

# Visual Studio cache
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.dbmdl
*.jfm

# Rider
.idea/
*.sln.iml

# MSTest
TestResults/
[Tt]est[Rr]esult*/
*.VisualState.xml
*.rsuser

# NuGet
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
!**/[Pp]ackages/repositories.config

# Others
*.bak
*.cache
*.log
*.tmp
appsettings.Development.json
appsettings.local.json
secrets.json