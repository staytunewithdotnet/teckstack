<Window x:Class="ProductManagement.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Management - Clean Architecture Learning" Height="500" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Form Area -->
        <GroupBox Header="Add New Product" Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Vertical" Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="Product Name:" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="ProductNameTextBox" Width="250" Height="30" 
                             Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalContentAlignment="Center" Padding="5"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Label Content="Quantity:" Width="100" VerticalAlignment="Center"/>
                    <TextBox x:Name="ProductQuantityTextBox" Width="250" Height="30" 
                             Text="{Binding ProductQuantity, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Padding="5"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddProductButton" Content="Add Product" Width="120" Height="30" Margin="100,0,0,0"
                            Command="{Binding AddProductCommand}" />
                    
                    <Button x:Name="RefreshButton" Content="Refresh List" Width="120" Height="30" Margin="10,0,0,0"
                            Command="{Binding LoadProductsCommand}" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Loading Indicator -->
        <TextBlock Grid.Row="1" Margin="0,0,0,10" Text="Processing..." Foreground="Gray"
                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" 
                   HorizontalAlignment="Center"/>

        <!-- Products List Header -->
        <TextBlock Grid.Row="2" Text="Product List" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Products List -->
        <DataGrid x:Name="ProductsDataGrid" Grid.Row="3" 
                  ItemsSource="{Binding Products}" 
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  BorderBrush="LightGray" 
                  GridLinesVisibility="All">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>