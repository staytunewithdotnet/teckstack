<Window x:Class="WpfPerformanceDiagnosticsDemo.CustomerDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customer Details" Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e" Foreground="#ffffff">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Customer Profile Card" FontSize="20" FontWeight="Bold" Foreground="#3b82f6" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Name: " FontWeight="Bold" Width="100"/>
                <TextBlock x:Name="NameText" Text="John Doe"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Email: " FontWeight="Bold" Width="100"/>
                <TextBlock x:Name="EmailText" Text="john.doe@company.com"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Status: " FontWeight="Bold" Width="100"/>
                <TextBlock x:Name="StatusText" Text="Active" Foreground="#10b981"/>
            </StackPanel>

            <TextBlock Text="Timer Status:" FontWeight="Bold" Margin="0,10,0,2"/>
            <TextBlock x:Name="TimerTicksText" Text="Timer inactive" Foreground="#f59e0b"/>

            <TextBlock Text="Event Subs Count:" FontWeight="Bold" Margin="0,10,0,2"/>
            <TextBlock x:Name="EventsStatusText" Text="Not subscribed to static publisher" Foreground="#ec4899"/>

            <!-- Large Image display (used for Bitmap leak test) -->
            <Border BorderBrush="#333333" BorderThickness="1" Height="120" CornerRadius="8" Background="#2a2a2a" Margin="0,10,0,0">
                <Image x:Name="CustomerPhoto" Stretch="Uniform"/>
            </Border>
        </StackPanel>

        <Button Grid.Row="2" Content="Close" Click="CloseButton_Click" Height="35" Width="100" HorizontalAlignment="Right"
                Background="#3b82f6" Foreground="White" BorderThickness="0">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>
